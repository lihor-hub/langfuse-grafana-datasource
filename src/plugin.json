{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Langfuse",
  "id": "lihorhub-langfuse-datasource",
  "metrics": true,
  "logs": true,
  "info": {
    "description": "Read-only Grafana data source for Langfuse v4 observability data",
    "author": {
      "name": "Lihor"
    },
    "keywords": ["datasource", "langfuse", "observability"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/lihor-hub/langfuse-grafana-datasource"
      }
    ],
    "screenshots": [
      { "name": "Synthetic platform observability overview", "path": "img/platform-observability-overview.png" },
      { "name": "Synthetic platform observability trends", "path": "img/platform-observability-trends.png" },
      { "name": "Synthetic platform observability details", "path": "img/platform-observability-details.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Platform AI Observability",
      "path": "provisioning/dashboards/platform-observability.json"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
