{
  "name": "langfuse",
  "version": "0.2.0",
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "format:check": "prettier --check src scripts tests docs/maintainers docs/onboarding.md docs/mock-langfuse.md",
    "test:fixtures": "node --test tests/mock-langfuse/server.test.mjs",
    "test:release-tools": "node --test scripts/release-tools.test.mjs scripts/ftp-compatibility.test.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "smoke:real": "node --test tests/smoke/real-langfuse.test.mjs",
    "validate": "node scripts/validate-plugin.mjs",
    "package": "node scripts/package-plugin.mjs",
    "check:repository": "node scripts/validate-repository.mjs",
    "check:markdown": "markdownlint-cli2 '**/*.md' '#node_modules/**' '#.config/**' '#docs/superpowers/plans/**' '#docs/superpowers/specs/**'",
    "check:links": "markdown-link-check --config .markdown-link-check.json README.md CONTRIBUTING.md SECURITY.md SUPPORT.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md docs/agents/domain.md docs/agents/issue-tracker.md docs/agents/triage-labels.md docs/agents/repository-rules.md docs/maintainers/github-settings.md docs/maintainers/releasing.md docs/maintainers/grafana-catalog-launch.md",
    "check:links:public": "markdown-link-check --config .markdown-link-check.public.json README.md CONTRIBUTING.md SECURITY.md SUPPORT.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md docs/agents/domain.md docs/agents/issue-tracker.md docs/agents/triage-labels.md docs/agents/repository-rules.md docs/maintainers/github-settings.md docs/maintainers/releasing.md docs/maintainers/grafana-catalog-launch.md",
    "check": "npm run check:repository && npm run check:markdown && npm run check:links"
  },
  "author": "Lihor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lihor-hub/langfuse-grafana-datasource.git"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "3.10.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "1.61.1",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.24.1",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^17.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.6"
    }
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.3.1",
    "@grafana/i18n": "13.3.1",
    "@grafana/runtime": "13.3.1",
    "@grafana/ui": "13.3.1",
    "@grafana/schema": "13.3.1",
    "@langfuse/core": "5.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "packageManager": "npm@10.9.8"
}
